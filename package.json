{
  "name": "myfood",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de delivery local — consumidor, estabelecimentos, entregadores e administração",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "npm run build:web && npm run build:api",
    "build:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test": "tsx --test apps/api/tests/*.test.ts",
    "seed": "tsx apps/api/src/db/seed.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.json --noEmit",
    "preview:web": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "start:api": "node --import tsx apps/api/src/server.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
