# ==== API ====
PORT=4000
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/myfood.db
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes
JWT_TTL_SECONDS=604800
NODE_ENV=production

# ==== Administrador inicial (usado apenas por `npm run seed`) ====
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=alem-branca-segura-aqui

# ==== Pagamentos: online, webhooks e estornos bloqueados até integração validada ====
PAYMENTS_PROVIDER=none
# Mercado Pago:
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Pagar.me:
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://api.seu-dominio.com

# ==== Reservado: mapas / geocodificação ainda não implementados ====
GEOCODING_URL=
GEOCODING_API_KEY=

# ==== Reservado: push Web ainda não implementado ====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==== Mobile (apps/mobile/.env) ====
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_WS_HOST=192.168.1.10:4000
